+    """全候補を1回（必要なら最小チャンク数）のPOSTで判定する。
+
+    post_fn はテスト用の注入ポイントで、chunk(項目リスト)を受け取り
+    (parsed_dict, usage_dict) を返す。None なら実APIを呼ぶ。
+    """
+    attempts_counter: List[int] = [0]
+    if post_fn is None:
