# Discord（ローカル接続テストでは空欄でも可）
DISCORD_WEBHOOK_URL=

# 判定AI: claude_cli（Claude Code CLI / Proサブスクリプション。既定）または deepseek（API）
AI_BACKEND=claude_cli
# Claudeのモデル（sonnet / opus / haiku）。未指定なら config/targets.yaml の ai.claude_cli.model
CLAUDE_MODEL=
# claude コマンドの場所（PATHに無い場合のみ）
CLAUDE_CLI_PATH=

# DeepSeek V4 Pro（AI_BACKEND=deepseek のときのみ使用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=true

# 対象卒年
GRADUATION_YEAR=2028
